# Only for running on your own computer (npm start).
# Copy this file to a new file named ".env" and fill it in. Never upload ".env".
# On Render, set the same names in the Environment tab instead.
EULERSTREAM_SIGN_API_KEY=
TIKTOK_USERNAME=
# CHAT_DEBUG_LOG=true

# ---- Score storage (v3.0) ----
# Recommended, free: an Upstash Redis database (console.upstash.com), REST API tab.
# Leave both blank to use a local file only (see README.md for the tradeoffs).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
